{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/usdimpact/usd-impact-pipeline/blob/main/research/score_v2_predictive_preregistration.schema.json",
  "title": "USD Impact Score v2 one-week DXY predictive preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol_id",
    "protocol_version",
    "registered_date",
    "registration_status",
    "production_change",
    "production_methodology_affected",
    "current_predictive_claim_authorized",
    "trading_strategy_claim",
    "purpose",
    "knowledge_boundary",
    "predictor",
    "target",
    "comparators",
    "sample_integrity",
    "primary_endpoint",
    "meaningful_predictive_evidence_rule",
    "secondary_endpoints",
    "reporting_policy",
    "amendment_policy",
    "limitations"
  ],
  "properties": {
    "$schema": {"const": "./score_v2_predictive_preregistration.schema.json"},
    "protocol_id": {"const": "usd_impact_score_v2_one_week_dxy_direction_2026-08-25"},
    "protocol_version": {"const": 1},
    "registered_date": {"const": "2026-08-25"},
    "registration_status": {"const": "preregistered_before_untouched_holdout"},
    "production_change": {"const": false},
    "production_methodology_affected": {"const": false},
    "current_predictive_claim_authorized": {"const": false},
    "trading_strategy_claim": {"const": false},
    "purpose": {"type": "string", "minLength": 1},
    "knowledge_boundary": {"type": "object"},
    "predictor": {"type": "object"},
    "target": {"type": "object"},
    "comparators": {"type": "object"},
    "sample_integrity": {"type": "object"},
    "primary_endpoint": {"type": "object"},
    "meaningful_predictive_evidence_rule": {"type": "object"},
    "secondary_endpoints": {"type": "array", "minItems": 3, "maxItems": 3},
    "reporting_policy": {"type": "object"},
    "amendment_policy": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1}
  }
}
