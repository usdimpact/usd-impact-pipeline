{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/usdimpact/usd-impact-pipeline/blob/main/research/score_v2_predictive_manifest.schema.json",
  "title": "USD Impact Score v2 prospective predictive manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "manifest_version",
    "study",
    "research_only",
    "production_change",
    "predictive_power_status",
    "append_only",
    "locked_preregistration_commit_sha",
    "locked_preregistration_file_sha256",
    "implementation_contract_sha256",
    "first_prediction_origin",
    "required_predictive_origins",
    "required_weekly_observations",
    "interim_integrity_checkpoints",
    "entries"
  ],
  "properties": {
    "$schema": {"const": "./score_v2_predictive_manifest.schema.json"},
    "manifest_version": {"const": 1},
    "study": {"const": "usd_impact_score_v2_one_week_dxy_direction_2026-08-25"},
    "research_only": {"const": true},
    "production_change": {"const": false},
    "predictive_power_status": {"const": "not_established_pending_52_resolved_predictions"},
    "append_only": {"const": true},
    "locked_preregistration_commit_sha": {"const": "89bf56bafd594987176f31efaa926ecf02228289"},
    "locked_preregistration_file_sha256": {"const": "36accc42e4915bb48caa1c4d2fd0fac8ba27c51c0eb988916990c415830e3ca0"},
    "implementation_contract_sha256": {"const": "13c2b546abda5c7ba44bdf178371346062d6717c1ed7f10f6a16aac319a9f789"},
    "first_prediction_origin": {"const": "2026-08-28"},
    "required_predictive_origins": {"const": 52},
    "required_weekly_observations": {"const": 53},
    "interim_integrity_checkpoints": {
      "type": "array",
      "prefixItems": [{"const": 13}, {"const": 26}, {"const": 39}],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "entries": {
      "type": "array",
      "maxItems": 53,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "week",
          "record_role",
          "recorded_at_utc",
          "source_v2_bundle_sha256",
          "source_v2_pipeline_commit_sha",
          "source_v2_attestation_status",
          "source_v2_attestation_run_id",
          "locked_preregistration_commit_sha",
          "implementation_contract_sha256",
          "weekly_record_file",
          "weekly_record_sha256"
        ],
        "properties": {
          "week": {"type": "string", "format": "date"},
          "record_role": {"enum": ["predictive_origin", "terminal_outcome"]},
          "recorded_at_utc": {"type": "string", "minLength": 20},
          "source_v2_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_v2_pipeline_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "source_v2_attestation_status": {"const": "passed"},
          "source_v2_attestation_run_id": {"type": "integer", "minimum": 1},
          "locked_preregistration_commit_sha": {"const": "89bf56bafd594987176f31efaa926ecf02228289"},
          "implementation_contract_sha256": {"const": "13c2b546abda5c7ba44bdf178371346062d6717c1ed7f10f6a16aac319a9f789"},
          "weekly_record_file": {"type": "string", "pattern": "^score_v2_predictive_week_[0-9]{4}-[0-9]{2}-[0-9]{2}\\.json$"},
          "weekly_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
