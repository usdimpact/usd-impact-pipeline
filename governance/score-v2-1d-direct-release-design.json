  "proposed_slots": [
    {
      "slot": "USD",
      "source_family": "Federal Reserve Board",
      "product": "H.10 Foreign Exchange Rates",
      "series_label": "Nominal Broad U.S. Dollar Index",
      "source_key": "DTWEXBGS",
      "transform": "level",
      "weight": 0.125,
      "direction": "positive",
      "conceptual_role": "broad USD strength",
      "release_rule": "Monday 16:15 ET for previous business week's daily observations",
      "rights_status": "strong_candidate_pending_series_exception_check"
    },
    {
      "slot": "ENERGY",
      "source_family": "EIA",
      "product": "Cushing, OK WTI Spot Price FOB",
      "series_label": "WTI Cushing spot",
      "source_key": "DCOILWTICO",
      "transform": "natural_log_level",
      "weight": -0.125,
      "direction": "negative",
      "conceptual_role": "energy/commodity transmission",
      "release_rule": "use only values included in an EIA release dated on or before the weekly cutoff",
      "rights_status": "strong_candidate_pending_release_history_rule"
    },
    {
      "slot": "FIN_CONDITIONS",
      "source_family": "Federal Reserve Board",
      "product": "H.8 Assets and Liabilities of Commercial Banks in the United States",
      "series_label": "Bank Credit, All Commercial Banks",
      "source_key": "BOARD_H8_BANK_CREDIT_ALL",
      "transform": "negative_log_change_13_weeks",
      "weight": 0.125,
      "direction": "positive",
      "conceptual_role": "bank-credit contraction / tightening",
      "release_rule": "Friday generally 16:15 ET; use only H.8 observations contained in releases available by cutoff",
      "interpretation": "A decline in bank credit over 13 weeks becomes a positive tightening signal.",
      "rights_status": "strong_candidate_pending_series_exception_check"
    },
    {
      "slot": "FIN_STRESS",
      "source_family": "Federal Reserve Board",
      "product": "H.4.1 Factors Affecting Reserve Balances",
      "series_label": "Primary Credit outstanding",
      "source_key": "BOARD_H41_PRIMARY_CREDIT",
      "transform": "log1p_level",
      "weight": 0.125,
      "direction": "positive",
      "conceptual_role": "discount-window stress / emergency funding demand",
      "release_rule": "Thursday generally 16:30 ET; use Wednesday level only after release",
      "interpretation": "Higher primary-credit usage is treated as greater banking-system funding stress.",
      "rights_status": "strong_candidate_pending_series_exception_check"
    },
    {
      "slot": "LIQUIDITY",
      "source_family": "Federal Reserve Board",
      "product": "H.4.1 Factors Affecting Reserve Balances",
      "series_label": "Total Assets, Wednesday Level",
      "source_key": "WALCL",
      "transform": "log_change_13_weeks",
      "weight": -0.125,
      "direction": "negative",
      "conceptual_role": "central-bank balance-sheet liquidity impulse",
      "release_rule": "Thursday generally 16:30 ET; use Wednesday level only after release",
      "rights_status": "strong_candidate_pending_series_exception_check"
    },
    {
      "slot": "REAL_YIELD",
      "source_family": "Federal Reserve Board",
      "product": "H.15 Selected Interest Rates",
      "series_label": "10-Year Inflation-Indexed Treasury Constant Maturity",
      "source_key": "DFII10",
      "transform": "level",
      "weight": 0.125,
      "direction": "positive",
      "conceptual_role": "real-rate pressure",
      "release_rule": "Monday-Friday 16:15 ET; only use observations included in a posted release",
      "rights_status": "strong_candidate_pending_series_exception_check"
    },
    {
      "slot": "UST_2Y",
      "source_family": "Federal Reserve Board",
      "product": "H.15 Selected Interest Rates",
