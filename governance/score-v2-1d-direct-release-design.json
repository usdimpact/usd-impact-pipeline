    {
      "slot": "UST_10Y",
      "source_family": "Federal Reserve Board",
      "product": "H.15 Selected Interest Rates",
      "series_label": "10-Year Treasury Constant Maturity",
      "source_key": "DGS10",
      "transform": "level",
      "weight": 0.125,
      "direction": "positive",
      "conceptual_role": "long-end nominal-rate pressure",
      "release_rule": "Monday-Friday 16:15 ET; only use observations included in a posted release",
      "rights_status": "strong_candidate_pending_series_exception_check"
    }
