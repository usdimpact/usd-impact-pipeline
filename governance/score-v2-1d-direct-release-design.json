  "structural_rules": {
    "weekly_anchor": "completed Friday",
    "observation_date_is_not_release_date": true,
    "point_in_time_release_provenance_required": true,
    "minimum_prior_complete_weeks": 104,
    "normalization": "expanding_point_in_time_zscore",
    "zscore_clip": 3.5,
    "missing_slot_policy": "fail_closed_no_score",
    "dynamic_reweighting": false,
    "proxy_autofill": false,
    "target_start": "2015-01-02"
  },
  "direct_release_advantage": {
    "composite_private_input_slots": 0,
    "direct_board_slots": 7,
    "direct_eia_slots": 1,
    "statement": "Unlike v2.1C, the conceptual inputs are direct statistical-release values or transformations of them rather than published composite indexes built from proprietary market feeds."
  },
  "known_research_risks": [
    "H.8 bank credit is an estimated/revised balance-sheet series, not a market financial-conditions index.",
    "H.8 historical releases incorporate benchmark revisions and reclassifications; point-in-time vintages are required.",
    "Primary credit can be near zero for long periods, creating a sparse/stigma-sensitive stress signal.",
    "Primary credit may miss stress expressed through special facilities rather than the regular discount window.",
    "H.4.1 total assets and primary credit share one balance-sheet source family and may become correlated in crises.",
    "Rate slots remain concentrated in nominal/real Treasury conditions.",
    "No transform or weight is validated until a separately authorized preregistered research study."
  ],
  "preregistration_requirements": [
    "exact H.8 Board series/item mapping",
    "exact H.4.1 Primary Credit series/item mapping",
    "release-vintage archive strategy",
    "H.8 benchmark-revision handling",
    "primary-credit sparse-distribution diagnostics",
    "point-in-time transformation rules",
    "redundancy diagnostics",
    "acceptance thresholds fixed before results",
    "separate real_data_research_authorization"
  ],
  "next_allowed_step": "pin_exact_direct_release_series_identifiers_and_preregister_synthetic_timing_only",
  "real_data_research_authorized": false,
  "production_authorized": false
}
