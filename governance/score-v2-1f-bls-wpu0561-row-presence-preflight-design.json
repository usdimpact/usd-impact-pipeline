  "research_window": {
    "start": "2013-01-01",
    "end": "2026-10-23"
  },
  "supersedes": {
    "version": 1,
    "reason": "Hosted ubuntu-24.04 capability checks found no preinstalled PDF parser. Official BLS archived HTML for the April 2013 PPI release exposes the Crude petroleum row with commodity code 05-61, allowing a dependency-free standard-library design."
  },
  "runtime_capability_evidence": {
    "initial_run": "https://github.com/usdimpact/usd-impact-pipeline/actions/runs/40770754204",
    "expanded_run": "https://github.com/usdimpact/usd-impact-pipeline/actions/runs/40771354805",
    "python_standard_library_zip_xml": true,
    "pdftotext": false,
    "pdfinfo": false,
    "mutool": false,
    "qpdf": false,
    "ghostscript": false,
    "libreoffice": false,
    "pypdf": false,
    "PyPDF2": false,
    "pdfplumber": false,
    "fitz": false,
    "pikepdf": false
  },
  "fixed_resources": [
    {
      "label": "april_2013_archived_html",
      "method": "GET",
      "host": "www.bls.gov",
      "path": "/news.release/archives/ppi_05152013.htm",
      "expected_format": "html"
    },
    {
      "label": "april_2026_xlsx",
      "method": "GET",
      "host": "www.bls.gov",
      "path": "/ppi/detailed-report/ppi-detailed-report-april-2026.xlsx",
      "expected_format": "xlsx"
    }
  ],
  "official_structural_evidence": {
    "2013_archived_html": "Public BLS archived release evidence exposes Crude petroleum with commodity code 05-61 in the April 2013 PPI release.",
    "wpu0561_literal_in_2013_html": false,
    "accepted_identity_tokens": [
      "WPU0561",
      "0561",
      "05-61",
      "Crude petroleum"
    ]
  },
  "objective": "Determine whether the two fixed official BLS responses expose a structurally identifiable WPU0561 / 0561 / 05-61 / Crude petroleum row or label without extracting, logging, persisting or publishing economic values.",
  "request_policy": {
    "request_budget": 2,
    "concurrency": 1,
    "automatic_retries": 0,
    "allowed_host": "www.bls.gov",
    "redirects": "reject_fail_closed",
    "transparent_contact_user_agent_required": true,
    "access_control_stop_statuses": [401, 403, 429],
    "challenge_detection_required": true
  },
  "runtime_parser_policy": {
    "html_parser": "python_standard_library_html_parser_only",
    "xlsx_parser": "python_standard_library_zip_xml_only",
    "install_new_system_software": false,
    "install_new_python_dependency": false,
    "external_parser_process": false
  },
  "structural_match_terms": [
    "WPU0561",
    "0561",
    "05-61",
    "Crude petroleum"
  ],
  "allowed_ephemeral_processing": [
    "read the two fixed response bodies into memory",
    "HTML table-row parsing in memory using Python standard library",
    "XLSX ZIP/XML string-cell parsing in memory using Python standard library",
    "ignore numeric cells and numeric source values",
    "emit only structural token/table/row/sheet identifiers and yes/no parseability"
  ],
  "forbidden": {
    "response_body_persistence": true,
    "numeric_source_value_persistence": true,
    "numeric_source_value_logging": true,
    "numeric_source_value_publication": true,
    "wpu0561_value_extraction": true,
    "full_historical_reconstruction": true,
    "bls_api_call": true,
    "bls_bulk_download": true,
    "alternate_source": true,
    "candidate_score_computation": true,
