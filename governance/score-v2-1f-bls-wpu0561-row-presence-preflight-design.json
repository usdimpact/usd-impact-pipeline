    "component_contribution_computation": true,
    "research_ledger_mutation": true,
    "public_artifact_replacement": true,
    "production_change": true
  },
  "allowed_persistent_output": [
    "pass/fail status",
    "request count",
    "resource path",
    "format",
    "matched structural identifier tokens",
    "HTML table and row numbers containing a structural match",
    "XLSX sheet names and row numbers containing a structural match",
    "structural parseability yes/no",
    "non-value-bearing error category"
  ],
  "current_authorizations": {
