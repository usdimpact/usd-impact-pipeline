{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usd-impact.com/schemas/score-v2-1f-bls-detailed-report-metadata-preflight-authorization.schema.json",
  "title": "Score v2.1F BLS Detailed Report metadata-only preflight authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "decision_status",
    "methodology_version",
    "issue",
    "blocker_issue",
    "execution_scope",
    "data_window",
    "request_budget",
    "contact_user_agent",
    "allowed_host",
    "allowed_requests",
    "storage_policy",
    "authorizations",
    "approved_by",
    "approved_at",
    "notes"
  ],
  "properties": {
    "version": {"const": 1},
    "decision_status": {"enum": ["hold", "approved"]},
    "methodology_version": {"const": "2.1F-design-candidate"},
    "issue": {"const": "https://github.com/usdimpact/usd-impact-pipeline/issues/230"},
    "blocker_issue": {"const": "https://github.com/usdimpact/usd-impact-pipeline/issues/228"},
    "execution_scope": {"const": "bls_detailed_report_metadata_preflight_only"},
    "data_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": ["string", "null"], "format": "date"},
        "end": {"type": ["string", "null"], "format": "date"}
      }
    },
    "request_budget": {"const": 4},
    "contact_user_agent": {
      "type": ["string", "null"],
      "pattern": "^USD-Impact-Score-v2\\.1F-BLS-metadata-preflight/1\\.0 \\(contact: .+\\)$"
    },
    "allowed_host": {"const": "www.bls.gov"},
    "allowed_requests": {
      "const": [
        "GET /robots.txt",
        "GET /ppi/detailed-report/",
        "HEAD one 2013 report resource selected from the official index",
        "HEAD one 2026 report resource selected from the official index"
      ]
    },
    "storage_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_values",
        "report_bodies",
        "cookies",
        "credentials",
        "durable_private_storage"
      ],
      "properties": {
        "source_values": {"const": "forbidden"},
        "report_bodies": {"const": "ephemeral_index_only_no_report_body"},
        "cookies": {"const": "do_not_persist"},
        "credentials": {"const": "forbidden"},
        "durable_private_storage": {"const": false}
      }
    },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_metadata_fetch",
        "bls_metadata_preflight",
        "report_body_download",
        "source_value_retrieval",
        "real_data_research",
        "candidate_score_computation",
        "research_ledger_mutation",
        "public_artifact_replacement",
        "production"
      ],
      "properties": {
        "network_metadata_fetch": {"type": "boolean"},
        "bls_metadata_preflight": {"type": "boolean"},
        "report_body_download": {"const": false},
        "source_value_retrieval": {"const": false},
        "real_data_research": {"const": false},
        "candidate_score_computation": {"const": false},
        "research_ledger_mutation": {"const": false},
        "public_artifact_replacement": {"const": false},
        "production": {"const": false}
      }
    },
    "approved_by": {"type": ["string", "null"], "minLength": 1},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision_status": {"const": "hold"}},
        "required": ["decision_status"]
      },
      "then": {
        "properties": {
          "data_window": {
            "properties": {
              "start": {"const": null},
              "end": {"const": null}
            }
          },
          "contact_user_agent": {"const": null},
          "authorizations": {
            "properties": {
              "network_metadata_fetch": {"const": false},
              "bls_metadata_preflight": {"const": false}
            }
          },
          "approved_by": {"const": null},
          "approved_at": {"const": null}
        }
      }
    },
    {
      "if": {
        "properties": {"decision_status": {"const": "approved"}},
        "required": ["decision_status"]
      },
      "then": {
        "properties": {
          "data_window": {
            "properties": {
              "start": {"const": "2013-01-01"},
              "end": {"const": "2026-10-23"}
            }
          },
          "contact_user_agent": {"type": "string"},
          "authorizations": {
            "properties": {
              "network_metadata_fetch": {"const": true},
              "bls_metadata_preflight": {"const": true}
            }
          },
          "approved_by": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  ]
}