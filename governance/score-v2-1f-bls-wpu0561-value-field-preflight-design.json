{
  "version": 1,
  "state": "design_only_hold",
  "methodology_version": "2.1F-design-candidate",
  "owner_decision_issue": "https://github.com/usdimpact/usd-impact-pipeline/issues/245",
  "predecessor_issue": "https://github.com/usdimpact/usd-impact-pipeline/issues/236",
  "controlling_rights_hold": "https://github.com/usdimpact/usd-impact-pipeline/issues/155",
  "fixed_resources": [
    "/news.release/archives/ppi_05152013.htm",
    "/ppi/detailed-report/ppi-detailed-report-april-2026.xlsx"
  ],
  "objective": "Determine whether each structurally identified crude-petroleum row can be mapped unambiguously to the original-release numeric field needed for WPU0561 point-in-time reconstruction.",
  "future_live_budget": {
    "requests": 2,
    "max_numeric_observations_extracted": 2,
    "max_numeric_observations_per_resource": 1,
    "concurrency": 1,
    "automatic_retries": 0
  },
  "required_mapping_metadata": [
    "resource path",
    "structural identity token",
    "HTML table/row or XLSX sheet/row",
    "candidate numeric field or column label",
    "field semantic classification",
    "revision/footnote context",
    "ambiguity status"
  ],
  "allowed_field_semantics": [
    "index_level_original_release"
  ],
  "explicitly_rejected_semantics": [
    "monthly_percent_change",
    "annual_percent_change",
    "revised_current_history",
    "seasonally_adjusted_transform_unless_preregistered",
    "ambiguous_or_unlabeled_numeric_field"
  ],
  "fail_closed_conditions": [
    "more than one candidate numeric field remains",
    "field semantic cannot be distinguished from percent change",
    "revision status is ambiguous",
    "resource structure differs from preregistered mapping assumptions",
    "more than one numeric observation would be extracted from a resource",
    "full response body would be persisted",
    "full historical reconstruction would begin"
  ],
  "forbidden_now": {
    "live_bls_request": true,
    "numeric_value_extraction": true,
    "full_historical_reconstruction": true,
    "bls_api_or_bulk": true,
    "alternate_source": true,
    "candidate_score_computation": true,
    "research_ledger_mutation": true,
    "public_artifact_replacement": true,
    "production_change": true
  },
  "current_authorizations": {
    "response_body_ephemeral_retrieval": false,
    "representative_numeric_value_extraction": false,
    "value_field_mapping_preflight": false,
    "full_historical_reconstruction": false,
    "candidate_score_computation": false,
    "research_ledger_mutation": false,
    "public_artifact_replacement": false,
    "production": false
  },
  "next_gate": "new_explicit_owner_authorization_under_issue_245_required_before_any_live_request_or_numeric_extraction"
}