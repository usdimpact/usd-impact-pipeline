  "structural_rules": {
    "weekly_anchor": "completed Friday",
    "cutoff_timezone": "America/New_York",
    "cutoff_time": "23:59:59",
    "observation_date_is_not_release_date": true,
    "point_in_time_release_provenance_required": true,
    "minimum_prior_complete_weeks": 104,
    "normalization": "expanding_point_in_time_zscore",
    "zscore_clip": 3.5,
    "missing_slot_policy": "fail_closed_no_score",
    "dynamic_reweighting": false,
    "proxy_autofill": false,
    "target_start": "2015-01-02"
  },
  "rights_minimization": {
    "federal_reserve_board_slots": 7,
    "bls_slots": 1,
    "eia_refinitiv_wti_slots": 0,
    "proprietary_market_index_slots": 0,
    "composite_private_input_slots": 0,
    "statement": "All eight proposed inputs are direct published statistical series from federal agencies; no EIA-republished Refinitiv WTI, private market index, ETF proxy, or composite index built from private market feeds is required."
  },
  "known_research_risks": [
    "BLS WPU0561 is monthly and substantially slower than daily WTI/futures, changing the energy channel.",
    "BLS PPI observations are revised for four months, so point-in-time vintage reconstruction is mandatory.",
    "H.8 bank credit is estimated/revised and subject to benchmark changes/reclassifications.",
    "Primary credit can be near zero for long periods and is stigma-sensitive.",
    "Primary credit may miss stress expressed through special facilities rather than regular discount-window borrowing.",
    "H.4.1 total assets and primary credit may become correlated in crises.",
    "Treasury and real-yield slots may create rate-factor concentration.",
    "H.10 broad-dollar data are normally one business week behind the Friday score cutoff because the week's observations are released the following Monday."
  ],
  "preregistration_requirements": [
    "BLS WPU0561 historical vintage reconstruction strategy",
    "BLS four-month revision handling",
    "H.8 benchmark-revision handling",
    "primary-credit sparse-distribution diagnostics",
    "point-in-time release eligibility for all eight slots",
    "redundancy diagnostics",
    "acceptance thresholds fixed before results",
    "separate real_data_research_authorization"
  ],
