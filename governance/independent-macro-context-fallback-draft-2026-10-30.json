  "methodology": {
    "status": "DRAFT_ONLY_NO_OWNER_ECONOMIC_SIGN_OFF",
    "panel_type": "3_descriptive_dials_4_distinct_series",
    "no_composite_score": true,
    "no_normalization_or_weights": true,
    "no_backtest_or_regime_predictions": true,
    "no_trading_signal_or_investment_recommendation": true,
    "no_use_of_original_score_history": true,
    "week_pair": "two_consecutive_Fridays_both_2099_plus_in_test",
    "as_of_rule": "all_four_source_versions_for_both_weeks_must_have_actual_synthetic_first_published_version_and_first_seen_timestamps_before_cutoff",
    "source_publication_calendar_is_never_a_substitute_for_receipts": true,
    "treasury_2y_10y_same_curve_snapshot_and_revision": true,
    "dials": [
      {
        "id": "dollar_breadth",
        "label": "Dollar breadth (nominal)",
        "inputs": [
          "fed_h10_nominal_broad"
        ],
        "calculation": "Compare current published H.10 Broad Dollar index to preceding reference Friday; UP/DOWN/UNCHANGED",
        "numeric_public_value_allowed": false,
        "interpretation": "Dollar breadth only; not ICE DXY or performance/return signal"
      },
      {
        "id": "crude_inventory",
        "label": "Reported crude inventories",
        "inputs": [
          "eia_crude_stocks_weekly"
        ],
        "calculation": "Compare WPSR crude stocks excluding SPR against prior reference week; BUILD/DRAW/UNCHANGED",
        "numeric_public_value_allowed": false,
        "interpretation": "Inventory movement; NOT futures prices or proof of oil-price direction"
      },
      {
        "id": "treasury_curve",
        "label": "Nominal Treasury curve",
        "inputs": [
          "treasury_direct_2yr_par",
          "treasury_direct_10yr_par"
        ],
        "calculation": "Ten-year minus two-year yields (both same curve snapshot); POSITIVE/INVERTED/FLAT and STEEPENING/FLATTENING/UNCHANGED against prior week",
        "numeric_public_value_allowed": false,
        "interpretation": "Curve level and change; not direct real rates or monetary-policy recommendation"
      }
    ]
  },
