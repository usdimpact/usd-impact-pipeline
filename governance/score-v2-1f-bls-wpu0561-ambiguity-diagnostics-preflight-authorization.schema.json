    "decision_status": {"enum": ["hold", "approved"]},
    "methodology_version": {"const": "2.1F-design-candidate"},
    "issue": {"const": "https://github.com/usdimpact/usd-impact-pipeline/issues/258"},
    "execution_scope": {"const": "bls_wpu0561_ambiguity_diagnostics_preflight_only"},
