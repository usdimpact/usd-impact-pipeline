{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usd-impact.com/schemas/score-v2-1f-bls-wpu0561-ambiguity-diagnostics-preflight-authorization.schema.json",
  "title": "Score v2.1F BLS WPU0561 ambiguity diagnostics preflight authorization",
