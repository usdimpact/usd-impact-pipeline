{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usd-impact.com/schemas/score-v2-1f-bls-wpu0561-representative-index-preflight-authorization.schema.json",
  "title": "Score v2.1F BLS WPU0561 representative index preflight authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "decision_status",
    "methodology_version",
    "issue",
    "execution_scope",
    "request_budget",
    "max_observations_total",
    "max_observations_per_resource",
    "contact_user_agent",
    "allowed_host",
    "fixed_resources",
    "authorizations",
    "approved_by",
    "approved_at",
    "notes"
  ],
  "properties": {
    "version": {"const": 1},
    "decision_status": {"enum": ["hold", "approved"]},
    "methodology_version": {"const": "2.1F-design-candidate"},
    "issue": {"const": "https://github.com/usdimpact/usd-impact-pipeline/issues/252"},
    "execution_scope": {"const": "bls_wpu0561_representative_index_preflight_only"},
    "request_budget": {"const": 2},
    "max_observations_total": {"const": 2},
    "max_observations_per_resource": {"const": 1},
    "contact_user_agent": {
      "type": ["string", "null"],
      "pattern": "^USD-Impact-Score-v2\\.1F-WPU0561-representative-index/1\\.0 \\(contact: .+\\)$"
    },
    "allowed_host": {"const": "www.bls.gov"},
    "fixed_resources": {
      "const": [
        "/news.release/archives/ppi_05152013.htm",
        "/ppi/detailed-report/ppi-detailed-report-april-2026.xlsx"
      ]
    },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_body_ephemeral_retrieval",
        "representative_index_value_read",
        "representative_index_preflight",
        "full_historical_reconstruction",
        "candidate_score_computation",
        "research_ledger_mutation",
        "public_artifact_replacement",
        "production"
      ],
      "properties": {
        "response_body_ephemeral_retrieval": {"type": "boolean"},
        "representative_index_value_read": {"type": "boolean"},
        "representative_index_preflight": {"type": "boolean"},
        "full_historical_reconstruction": {"const": false},
        "candidate_score_computation": {"const": false},
        "research_ledger_mutation": {"const": false},
        "public_artifact_replacement": {"const": false},
        "production": {"const": false}
      }
    },
    "approved_by": {"type": ["string", "null"], "minLength": 1},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": "string"}
  }
}