{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usd-impact.com/schemas/score-private-evidence-receipt-v1.json",
  "title": "USD Impact private Score evidence handoff receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "latest_week",
    "archive_count",
    "files",
    "provider_derived_values_in_receipt",
    "worktree_contract"
  ],
  "properties": {
    "schema_version": { "const": "score-private-evidence-receipt-v1" },
    "latest_week": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "archive_count": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(public/data/|public/archive/)" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "provider_derived_values_in_receipt": { "const": false },
    "worktree_contract": { "const": "ephemeral-private-evidence-only" }
  }
}
