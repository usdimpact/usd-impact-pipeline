{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usd-impact.com/schemas/score-public-v2-safe-1.json",
  "title": "USD Impact Score public-safe aggregate artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "latest", "history", "release_evidence"],
  "properties": {
    "schema_version": { "const": "score-public-v2-safe-1" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline", "generated_at_utc", "n_weeks", "weights"],
      "properties": {
        "pipeline": { "type": "string" },
        "generated_at_utc": { "type": ["string", "null"] },
        "n_weeks": { "type": "integer", "minimum": 1 },
        "weights": {
          "type": "object",
          "additionalProperties": { "type": "number" },
          "minProperties": 1
        }
      }
    },
    "latest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["week_ending", "score", "regime", "week_over_week_change", "four_week_change"],
      "properties": {
        "week_ending": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "score": { "type": "number" },
        "regime": { "type": "string" },
        "week_over_week_change": { "type": "number" },
        "four_week_change": { "type": "number" }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "score", "regime"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "score": { "type": "number" },
          "regime": { "type": "string" }
        }
      }
    },
    "release_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate_history_sha256"],
      "properties": {
        "aggregate_history_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
