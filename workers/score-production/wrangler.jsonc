{
  "name": "usd-impact-score-production",
  "main": "./index.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SCORE_WORKER_ENABLED": "false",
    "SCORE_EDGE_GATE_ENABLED": "false",
    "SCORE_EDGE_REDEMPTION_ENABLED": "false",
    "SCORE_WORKER_ORIGIN": "https://score.usd-impact.com",
    "SCORE_WEBSITE_ORIGIN": "https://www.usd-impact.com",
    "SCORE_EDGE_BRIDGE_ORIGIN": "https://www.usd-impact.com"
  },
  "ratelimits": [
    {
      "name": "SCORE_REDEEM_LIMIT",
      "namespace_id": "817420631",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "SCORE_VALIDATE_LIMIT",
      "namespace_id": "817420632",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ],
  "previews": {
    "vars": {
      "SCORE_WORKER_ENABLED": "false",
      "SCORE_EDGE_GATE_ENABLED": "false",
      "SCORE_EDGE_REDEMPTION_ENABLED": "false",
      "SCORE_WORKER_ORIGIN": "https://score.usd-impact.com",
      "SCORE_WEBSITE_ORIGIN": "https://www.usd-impact.com",
      "SCORE_EDGE_BRIDGE_ORIGIN": "https://www.usd-impact.com"
    },
    "ratelimits": [
      {
        "name": "SCORE_REDEEM_LIMIT",
        "namespace_id": "817420631",
        "simple": {
          "limit": 30,
          "period": 60
        }
      },
      {
        "name": "SCORE_VALIDATE_LIMIT",
        "namespace_id": "817420632",
        "simple": {
          "limit": 180,
          "period": 60
        }
      }
    ]
  }
}
